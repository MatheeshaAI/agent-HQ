{
  "name": "agent-hq",
  "version": "0.2.0",
  "description": "Agent HQ: a 3D AI agent office for an LLM Wiki second brain",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "shot": "node scripts/shot.mjs",
    "dist": "electron-vite build && electron-builder --dir"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.460.0",
    "playwright-core": "^1.49.0",
    "postprocessing": "^6.36.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "zod": "^3.25.76"
  },
  "private": true,
  "build": {
    "appId": "com.matheesha.agenthq",
    "productName": "Agent HQ",
    "files": [
      "out/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "author": "Matheesha Sarathchandra"
}
